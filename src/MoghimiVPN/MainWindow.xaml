<Window x:Class="MoghimiVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moghimi VPN" Width="1420" Height="900" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#080B14" Foreground="#F4F6FF"
        FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" Closing="Window_Closing">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/Assets/moghimi-vpn-icon.png"/>
    </Window.Icon>
    <Window.Resources>
        <CollectionViewSource x:Key="ProfilesView" Source="{Binding Profiles}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="SourceGroup"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111827"/><Setter Property="BorderBrush" Value="#2B3855"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F5F8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F3F5F8"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="#191F2A" BorderBrush="#293343"
                                BorderThickness="1" CornerRadius="12" Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E63946"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#251A20"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#070A12" Offset="0"/><GradientStop Color="#0B1020" Offset="0.52"/><GradientStop Color="#111329" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="640" Height="640" Canvas.Right="-240" Canvas.Top="-300" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#507D8CFF" Offset="0"/>
                        <GradientStop Color="#007D8CFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="520" Height="520" Canvas.Left="180" Canvas.Bottom="-310" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#334D5EBB" Offset="0"/>
                        <GradientStop Color="#004D5EBB" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Border Grid.Column="0" BorderBrush="#263451" BorderThickness="0,0,1,0" Padding="21">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0B1222" Offset="0"/><GradientStop Color="#111B33" Offset="0.56"/><GradientStop Color="#17152D" Offset="1"/></LinearGradientBrush></Border.Background>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="70" Height="70" CornerRadius="22" Background="#202B50" BorderBrush="#647BCE" BorderThickness="1" HorizontalAlignment="Right" Margin="0,8,0,15">
                        <Grid><Image Source="pack://application:,,,/Assets/moghimi-vpn-icon.png" Stretch="Uniform" Margin="8"/></Grid>
                    </Border>
                    <TextBlock Text="MOGHIMI VPN" FontSize="22" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="SECURE CONNECTION  /  WINDOWS" FontSize="11" Foreground="#93A3C6" Margin="0,4,0,30"/>
                    <TextBlock Text="فضای کاری" Foreground="#7F91B5" FontSize="14" Margin="4,0,0,9"/>
                    <Button Style="{StaticResource NavButton}" Click="HomeNav_Click" Content="⌂    خانه"/>
                    <Button Style="{StaticResource NavButton}" Click="ProfilesNav_Click" Content="◈    کانفیگ‌ها"/>
                    <Button Style="{StaticResource NavButton}" Click="SubscriptionsNav_Click" Content="⟳    اشتراک‌ها"/>
                    <Button Style="{StaticResource NavButton}" Click="SettingsNav_Click" Content="⚙    تنظیمات"/>
                    <Button Style="{StaticResource NavButton}" Click="LogsNav_Click" Content="≡    گزارش اتصال"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#1A2440" BorderBrush="#34466E" BorderThickness="1" CornerRadius="16" Padding="13" Margin="0,20,0,4">
                    <StackPanel>
                        <TextBlock Text="حریم خصوصی" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="بدون ردیابی، تبلیغات یا ورود به حساب ویندوز" TextWrapping="Wrap" Foreground="#9BAAC6" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,25,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="داشبورد اتصال" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="PageDescription" Text="وضعیت اتصال و سرور فعال" Foreground="#9BAAC6" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#16243A" BorderBrush="#3B5C8C" BorderThickness="1" CornerRadius="20" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#E7A83E" Margin="0,0,8,0"/>
                        <TextBlock x:Name="HeaderStatus" Text="آماده اتصال" FontSize="13" Foreground="#CFD7E2"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="Pages_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
                </TabControl.Resources>

                <TabItem>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="154"/></Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" Background="#111C34" BorderBrush="#3A4B7A" Margin="0,0,14,14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MOGHIMI  /  PRIVATE NETWORK" FontSize="12" Foreground="#A5B5DF"/>
                                    <TextBlock Text="یک اتصال امن، با انتخاب خودت" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="ConnectButton" Click="ConnectButton_Click" Width="196" Height="196" Padding="0" Background="Transparent" BorderThickness="0">
                                        <Button.Effect>
                                            <DropShadowEffect Color="#667DFF" BlurRadius="38" ShadowDepth="0" Opacity="0.48"/>
                                        </Button.Effect>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Ellipse x:Name="OrbPulse" Fill="#467F91FF" Opacity="0.26" Stroke="#788CFF" StrokeThickness="1.5"/>
                                                    <Ellipse Margin="10" Fill="#1B2749" Stroke="#647BDB" StrokeThickness="1.5"/>
                                                    <Ellipse Margin="18">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush>
                                                                <GradientStop Color="#FFC8CEFF" Offset="0"/>
                                                                <GradientStop Color="#FF7187FF" Offset="0.60"/>
                                                                <GradientStop Color="#FF4656B0" Offset="1"/>
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Margin="29" Stroke="#FFDCE4FF" StrokeThickness="1" Opacity="0.38"/>
                                                    <TextBlock Text="⏻" FontSize="72" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock x:Name="ConnectionStatus" Text="قطع" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,4"/>
                                    <TextBlock x:Name="ProbeStatus" Text="سرور انتخاب‌شده آماده اتصال" Foreground="#8996A9" FontSize="13" HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="ProbeProgress" Width="230" Height="4" Margin="0,9,0,0" Maximum="100" Value="0" Visibility="Collapsed" Background="#222B38" Foreground="#E8C66A" BorderThickness="0"/>
                                    <Button x:Name="SmartConnectButton" Click="SmartConnect_Click" Content="✦  انتخاب هوشمند سریع‌ترین سرور" Height="42" MinWidth="270" Margin="0,12,0,0" Background="#4035223F" BorderBrush="#D7B96A" Foreground="#F7E7B1" Padding="18,9"/>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <TextBlock Text="حالت اتصال" Foreground="#9BAAC6" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ModeSummary" Text="TUN سراسری" Foreground="#F3F5F8" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="سرور انتخاب‌شده" Style="{StaticResource SectionTitle}"/>
                                <Border Background="#1C2430" BorderBrush="#2D394B" BorderThickness="1" CornerRadius="13" Padding="14">
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedProfileName" Text="هنوز سروری انتخاب نشده" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SelectedProfileEndpoint" Text="از بخش کانفیگ‌ها یک سرور اضافه کن" Foreground="#9BAAC6" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SelectedProfileLatency" Text="— ms" Foreground="#64DDBB" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <Border Background="#10151E" CornerRadius="9" Padding="10,8" Margin="0,12,0,0">
                                            <Grid>
                                                <TextBlock Text="مدت اتصال" Foreground="#9BAAC6" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SessionUptime" Text="00:00:00" Foreground="#9BAAC6" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource AppFont}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="نکته اتصال" FontWeight="SemiBold" Margin="0,20,0,6"/>
                                <TextBlock Text="در حالت TUN، ویندوز برای ساخت رابط شبکه یک‌بار پنجره رسمی UAC را نشان می‌دهد. لغو آن به معنی لغو اتصال است." Foreground="#A5B2CB" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                                <TextBlock Text="این برنامه در شروع ویندوز خودکار وصل نمی‌شود." Foreground="#A5B2CB" TextWrapping="Wrap" FontSize="13" Margin="0,11,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="شبکه" Foreground="#8996A9" FontSize="13"/>
                                    <TextBlock Text="VPN / Proxy" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DNS" Foreground="#8996A9" FontSize="13"/>
                                    <TextBlock x:Name="DnsSummary" Text="1.1.1.1" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="پروفایل‌ها" Foreground="#8996A9" FontSize="13"/>
                                    <TextBlock x:Name="ProfileCountSummary" Text="0" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="وضعیت امنیتی" FontWeight="SemiBold"/>
                                <TextBlock Text="بدون سرویس مخفی، بدون استثنای آنتی‌ویروس و بدون تغییر تنظیمات Defender" Foreground="#A5B2CB" TextWrapping="Wrap" FontSize="13" Margin="0,9,0,0" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="15">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right">
                                    <TextBlock Text="مدیریت سرورها" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="افزودن لینک، واردکردن فایل و تست تأخیر" Foreground="#9BAAC6" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                                <WrapPanel HorizontalAlignment="Left">
                                    <Button Click="ManualProfile_Click" Margin="4,0" Content="+ پروفایل دستی"/>
                                    <Button Click="AddLink_Click" Margin="4,0" Content="+ افزودن لینک"/>
                                    <Button Click="PasteClipboard_Click" Margin="4,0" Content="چسباندن از کلیپ‌بورد"/>
                                    <Button Click="ImportFile_Click" Margin="4,0" Content="واردکردن فایل"/>
                                    <Button Click="ImportQr_Click" Margin="4,0" Content="واردکردن QR"/>
                                    <Button Click="EditProfile_Click" Margin="4,0" Content="ویرایش"/>
                                    <Button Click="ShareProfile_Click" Margin="4,0" Content="کپی لینک"/>
                                    <Button Click="ExportQr_Click" Margin="4,0" Content="خروجی QR"/>
                                    <Button Click="ScanLatency_Click" Margin="4,0" Content="◉ تست تاخیر انتخاب‌شده"/>
                                    <Button Click="RemoveProfile_Click" Margin="4,0" Content="حذف انتخاب‌شده"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        <ListView x:Name="ProfilesList" Grid.Row="1" ItemsSource="{Binding Source={StaticResource ProfilesView}}" SelectionChanged="ProfilesList_SelectionChanged">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="#E6A0A6" FontSize="14" FontWeight="SemiBold" Margin="4,12,4,6"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#9BAAC6" FontSize="13" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding LatencyMs, StringFormat={}{0} ms}" Foreground="#64DDBB" FontSize="14" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="اشتراک‌ها و کانفیگ‌های سایت" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="اشتراک اینترنتی را اضافه و در زمان دلخواه به‌روزرسانی کن. همگام‌سازی سایت مقیمی فقط آیتم‌های فعال را دریافت می‌کند." Foreground="#A5B2CB" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Click="AddSubscription_Click" Content="+ افزودن اشتراک" Margin="4,0"/>
                                    <Button Click="RefreshSubscription_Click" Content="به‌روزرسانی اشتراک انتخاب‌شده" Margin="4,0"/>
                                    <Button Click="RemoveSubscription_Click" Content="حذف اشتراک" Margin="4,0"/>
                                    <Button Click="CloudSync_Click" Content="همگام‌سازی سایت مقیمی" Margin="4,0" Background="#39212A" BorderBrush="#8F3846"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ListView x:Name="SubscriptionsList" Grid.Row="1" ItemsSource="{Binding Subscriptions}" SelectionChanged="SubscriptionsList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Url}" Foreground="#9BAAC6" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding LastStatus}" Foreground="#64DDBB" FontSize="12" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Background="#20271D30" BorderBrush="#8B7549" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="به‌روزرسانی برنامه ویندوز" Style="{StaticResource SectionTitle}" Foreground="#F2D98E"/>
                                    <TextBlock x:Name="WindowsUpdateStatusText" Text="برای بررسی نسخه جدید، دکمه بررسی را بزن." Foreground="#D9D1E7" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="CheckWindowsUpdateButton" Click="CheckWindowsUpdate_Click" Content="بررسی نسخه جدید" Margin="4,0" Background="#493C25" BorderBrush="#C6A95A"/>
                                        <Button x:Name="InstallWindowsUpdateButton" Click="InstallWindowsUpdate_Click" Content="دانلود و نصب نسخه جدید" IsEnabled="False" Margin="4,0" Background="#5744A0" BorderBrush="#B69AF2"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Background="#302A2742" BorderBrush="#9C8556" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="فعال‌سازی اشتراک ویندوز" Style="{StaticResource SectionTitle}" Foreground="#F4D88B"/>
                                    <TextBlock Text="کد خرید ویندوز را از بات تلگرام دریافت کن و اینجا ثبت کن. اطلاعات فعال‌سازی با DPAPI برای حساب فعلی ویندوز رمزگذاری می‌شود." Foreground="#C9C3D9" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="LicenseStatusText" Text="در حال بررسی وضعیت اشتراک…" Foreground="#E8D9A8" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="ActivateWindowsButton" Click="ActivateWindows_Click" Content="ثبت کد فعال‌سازی" Margin="4,0" Background="#6D55B8" BorderBrush="#B69AF2"/>
                                        <Button Click="RefreshWindowsLicense_Click" Content="بررسی مجدد اشتراک" Margin="4,0" Background="#4A432B" BorderBrush="#B69A53"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="حالت اتصال" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="VPN Mode ترافیک دستگاه را از تونل مجازی عبور می‌دهد و برای فعال‌سازی UAC ویندوز می‌خواهد. Proxy Mode فقط برنامه‌هایی را پوشش می‌دهد که از پراکسی سیستم پیروی می‌کنند؛ تنظیم قبلی پس از قطع اتصال بازگردانده می‌شود." Foreground="#A5B2CB" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="ConnectionModeCombo" Width="220" HorizontalAlignment="Right" SelectedIndex="0">
                                        <ComboBoxItem Content="VPN Mode — کل سیستم" Tag="TUN"/>
                                        <ComboBoxItem Content="Proxy Mode — برنامه‌های سازگار" Tag="System Proxy"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="DNS و مسیریابی" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="DNS سرور" Foreground="#A5B2CB" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="DnsTextBox" Width="280" HorizontalAlignment="Right" Text="1.1.1.1"/>
                                    <CheckBox x:Name="BlockAdsCheck" Content="مسدودسازی دامنه‌های تبلیغاتی رایج" IsChecked="True" Margin="0,15,0,0"/>
                                    <CheckBox x:Name="BypassLanCheck" Content="عبور مستقیم شبکه‌های خصوصی و LAN" IsChecked="True"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="دسترسی‌ها و شفافیت" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="• VPN Mode: دسترسی مدیر فقط هنگام اتصال و از طریق UAC رسمی ویندوز." Foreground="#C2CBD7" FontSize="14" Margin="0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Proxy Mode: تنظیمات کاربر فعلی؛ مقدار قبلی هنگام قطع اتصال بازگردانده می‌شود." Foreground="#C2CBD7" FontSize="14" Margin="0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="• برنامه رمز ویندوز، مرورگر، مخاطبان یا اطلاعات حساب را نمی‌خواند." Foreground="#C2CBD7" FontSize="14" Margin="0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Defender خاموش نمی‌شود و هیچ استثنایی به آنتی‌ویروس اضافه نمی‌شود." Foreground="#C2CBD7" FontSize="14" Margin="0,4" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Button Click="SaveSettings_Click" Content="ذخیره تنظیمات" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Width="180"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="گزارش محلی هسته اتصال" Foreground="#A5B2CB" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Left" Click="RefreshLogs_Click" Content="تازه‌سازی"/>
                        </DockPanel>
                        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource AppFont}" FontSize="13"
                                 Background="#090B10" Padding="16"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
