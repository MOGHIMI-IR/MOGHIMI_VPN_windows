<Window x:Class="MoghimiVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moghimi VPN" Width="1240" Height="790" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0B0D12" Foreground="#F3F5F8"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#141821"/>
            <Setter Property="BorderBrush" Value="#283140"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F5F8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F3F5F8"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="#191F2A" BorderBrush="#293343"
                                BorderThickness="1" CornerRadius="12" Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E63946"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#251A20"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#10141C" BorderBrush="#252D3A" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="58" Height="58" CornerRadius="18" Background="#E63946" HorizontalAlignment="Right" Margin="0,8,0,12">
                        <Grid>
                            <TextBlock Text="M" FontSize="32" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="8" Height="8" Fill="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="MOGHIMI" FontSize="19" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="V P N   /   WINDOWS" FontSize="10" Foreground="#8793A5" Margin="0,2,0,28"/>
                    <TextBlock Text="فضای کاری" Foreground="#687588" FontSize="11" Margin="4,0,0,9"/>
                    <Button Style="{StaticResource NavButton}" Click="HomeNav_Click" Content="⌂    خانه"/>
                    <Button Style="{StaticResource NavButton}" Click="ProfilesNav_Click" Content="◈    کانفیگ‌ها"/>
                    <Button Style="{StaticResource NavButton}" Click="SubscriptionsNav_Click" Content="⟳    اشتراک‌ها"/>
                    <Button Style="{StaticResource NavButton}" Click="SettingsNav_Click" Content="⚙    تنظیمات"/>
                    <Button Style="{StaticResource NavButton}" Click="LogsNav_Click" Content="≡    گزارش اتصال"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#171D27" CornerRadius="13" Padding="13" Margin="0,20,0,4">
                    <StackPanel>
                        <TextBlock Text="حریم خصوصی" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="بدون ردیابی، تبلیغات یا ورود به حساب ویندوز" TextWrapping="Wrap" Foreground="#8D98A9" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="داشبورد اتصال" FontSize="23" FontWeight="Bold"/>
                    <TextBlock x:Name="PageDescription" Text="وضعیت اتصال و سرور فعال" Foreground="#8D98A9" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#18241F" BorderBrush="#28533D" BorderThickness="1" CornerRadius="20" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#E7A83E" Margin="0,0,8,0"/>
                        <TextBlock x:Name="HeaderStatus" Text="آماده اتصال" FontSize="11" Foreground="#CFD7E2"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
                </TabControl.Resources>

                <TabItem>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="154"/></Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,14,14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MOGHIMI / SECURE TUNNEL" FontSize="10" Foreground="#8996A9"/>
                                    <TextBlock Text="اتصال امن، با کنترل کامل" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="ConnectButton" Click="ConnectButton_Click" Width="178" Height="178" Padding="0" Background="#E63946" BorderBrush="#F36B75" BorderThickness="2">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Ellipse Fill="#3A1B25" Stroke="#612530" StrokeThickness="2"/>
                                                    <Ellipse Margin="10" Fill="#E63946"/>
                                                    <Ellipse Margin="24" Stroke="#FFBEC4" StrokeThickness="1" Opacity="0.35"/>
                                                    <TextBlock Text="⏻" FontSize="72" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock x:Name="ConnectionStatus" Text="قطع" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,4"/>
                                    <TextBlock Text="برای شروع اتصال، دکمه را بزن" Foreground="#8996A9" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <TextBlock Text="حالت اتصال" Foreground="#8D98A9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ModeSummary" Text="TUN سراسری" Foreground="#F3F5F8" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="سرور انتخاب‌شده" Style="{StaticResource SectionTitle}"/>
                                <Border Background="#1C2430" BorderBrush="#2D394B" BorderThickness="1" CornerRadius="13" Padding="14">
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedProfileName" Text="هنوز سروری انتخاب نشده" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SelectedProfileEndpoint" Text="از بخش کانفیگ‌ها یک سرور اضافه کن" Foreground="#8D98A9" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SelectedProfileLatency" Text="— ms" Foreground="#6FD3A4" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="نکته اتصال" FontWeight="SemiBold" Margin="0,20,0,6"/>
                                <TextBlock Text="در حالت TUN، ویندوز برای ساخت رابط شبکه یک‌بار پنجره رسمی UAC را نشان می‌دهد. لغو آن به معنی لغو اتصال است." Foreground="#9AA5B5" TextWrapping="Wrap" FontSize="11" LineHeight="18"/>
                                <TextBlock Text="این برنامه در شروع ویندوز خودکار وصل نمی‌شود." Foreground="#9AA5B5" TextWrapping="Wrap" FontSize="11" Margin="0,11,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="شبکه" Foreground="#8996A9" FontSize="11"/>
                                    <TextBlock Text="TUN / Proxy" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DNS" Foreground="#8996A9" FontSize="11"/>
                                    <TextBlock x:Name="DnsSummary" Text="1.1.1.1" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="پروفایل‌ها" Foreground="#8996A9" FontSize="11"/>
                                    <TextBlock x:Name="ProfileCountSummary" Text="0" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="وضعیت امنیتی" FontWeight="SemiBold"/>
                                <TextBlock Text="بدون سرویس مخفی، بدون استثنای آنتی‌ویروس و بدون تغییر تنظیمات Defender" Foreground="#9AA5B5" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="15">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right">
                                    <TextBlock Text="مدیریت سرورها" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="افزودن لینک، واردکردن فایل و تست تأخیر" Foreground="#8D98A9" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <WrapPanel HorizontalAlignment="Left">
                                    <Button Click="AddLink_Click" Margin="4,0" Content="+ افزودن لینک"/>
                                    <Button Click="PasteClipboard_Click" Margin="4,0" Content="چسباندن از کلیپ‌بورد"/>
                                    <Button Click="ImportFile_Click" Margin="4,0" Content="واردکردن فایل"/>
                                    <Button Click="ScanLatency_Click" Margin="4,0" Content="◉ تست پینگ"/>
                                    <Button Click="RemoveProfile_Click" Margin="4,0" Content="حذف انتخاب‌شده"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        <ListView x:Name="ProfilesList" Grid.Row="1" ItemsSource="{Binding Profiles}" SelectionChanged="ProfilesList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#8D98A9" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding LatencyMs, StringFormat={}{0} ms}" Foreground="#6FD3A4" FontSize="12" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="اشتراک‌ها و کانفیگ‌های سایت" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="اشتراک اینترنتی را اضافه و در زمان دلخواه به‌روزرسانی کن. همگام‌سازی سایت مقیمی فقط آیتم‌های فعال را دریافت می‌کند." Foreground="#9AA5B5" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Click="AddSubscription_Click" Content="+ افزودن اشتراک" Margin="4,0"/>
                                    <Button Click="RefreshSubscription_Click" Content="به‌روزرسانی اشتراک انتخاب‌شده" Margin="4,0"/>
                                    <Button Click="CloudSync_Click" Content="همگام‌سازی سایت مقیمی" Margin="4,0" Background="#39212A" BorderBrush="#8F3846"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ListView x:Name="SubscriptionsList" Grid.Row="1" ItemsSource="{Binding Subscriptions}" SelectionChanged="SubscriptionsList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Url}" Foreground="#8D98A9" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding LastStatus}" Foreground="#6FD3A4" FontSize="10" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="حالت اتصال" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="TUN تمام ترافیک دستگاه را از مسیر تونل می‌فرستد. System Proxy فقط برنامه‌هایی را پوشش می‌دهد که از پراکسی سیستم پیروی می‌کنند." Foreground="#9AA5B5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="ConnectionModeCombo" Width="220" HorizontalAlignment="Right" SelectedIndex="0">
                                        <ComboBoxItem Content="TUN"/>
                                        <ComboBoxItem Content="System Proxy"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="DNS و مسیریابی" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="DNS سرور" Foreground="#9AA5B5" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBox x:Name="DnsTextBox" Width="280" HorizontalAlignment="Right" Text="1.1.1.1"/>
                                    <CheckBox x:Name="BlockAdsCheck" Content="مسدودسازی دامنه‌های تبلیغاتی رایج" IsChecked="True" Margin="0,15,0,0"/>
                                    <CheckBox x:Name="BypassLanCheck" Content="عبور مستقیم شبکه‌های خصوصی و LAN" IsChecked="True"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="دسترسی‌ها و شفافیت" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="• TUN: دسترسی مدیر فقط هنگام اتصال و از طریق UAC رسمی ویندوز." Foreground="#C2CBD7" FontSize="12" Margin="0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="• System Proxy: تنظیمات کاربر فعلی؛ مقدار قبلی هنگام قطع اتصال بازگردانده می‌شود." Foreground="#C2CBD7" FontSize="12" Margin="0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="• برنامه رمز ویندوز، مرورگر، مخاطبان یا اطلاعات حساب را نمی‌خواند." Foreground="#C2CBD7" FontSize="12" Margin="0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Defender خاموش نمی‌شود و هیچ استثنایی به آنتی‌ویروس اضافه نمی‌شود." Foreground="#C2CBD7" FontSize="12" Margin="0,4" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Button Click="SaveSettings_Click" Content="ذخیره تنظیمات" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Width="180"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="گزارش محلی هسته اتصال" Foreground="#9AA5B5" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Left" Click="RefreshLogs_Click" Content="تازه‌سازی"/>
                        </DockPanel>
                        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                 Background="#090B10" Padding="16"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
