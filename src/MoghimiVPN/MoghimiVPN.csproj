<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MoghimiVPN</AssemblyName>
    <RootNamespace>MoghimiVPN</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Platforms>x64</Platforms>
    <UseSystemDrawing>true</UseSystemDrawing>
    <ApplicationIcon>Assets\moghimi-vpn-icon.ico</ApplicationIcon>
    <Company>Moghimi</Company>
    <Product>Moghimi VPN</Product>
    <Description>Moghimi VPN for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.17" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\moghimi-vpn-icon.png" />
    <Resource Include="Assets\Fonts\Estedad-Regular.ttf" />
    <Resource Include="Assets\Fonts\Estedad-Medium.ttf" />
    <Resource Include="Assets\Fonts\Estedad-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Estedad-Bold.ttf" />
    <Resource Include="Assets\Fonts\Estedad-ExtraBold.ttf" />
    <Resource Include="Assets\Fonts\Estedad-OFL.txt" />
  </ItemGroup>
</Project>
