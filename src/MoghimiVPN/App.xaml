<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="MoghimiVPN.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Estedad</FontFamily>
    <SolidColorBrush x:Key="Bg" Color="#080B18"/>
    <SolidColorBrush x:Key="Panel" Color="#B51A2744"/>
    <SolidColorBrush x:Key="Panel2" Color="#C5273152"/>
    <SolidColorBrush x:Key="Stroke" Color="#778B86B5"/>
    <SolidColorBrush x:Key="Accent" Color="#B39AFF"/>
    <SolidColorBrush x:Key="Accent2" Color="#F0CB78"/>
    <SolidColorBrush x:Key="Muted" Color="#B6C0D8"/>
    <SolidColorBrush x:Key="TextMain" Color="#F7F5FF"/>
    <LinearGradientBrush x:Key="GlassPanel" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#C5233152" Offset="0"/><GradientStop Color="#8E1C2945" Offset="0.55"/><GradientStop Color="#A71A2540" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassButton" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#D63C4569" Offset="0"/><GradientStop Color="#A5232E4E" Offset="1"/>
    </LinearGradientBrush>
    <!-- Motion is intentionally subtle and GPU-friendly; no continuously animated blur. -->
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="{StaticResource GlassButton}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,11"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#C1A6FF"/><Setter TargetName="Chrome" Property="Background" Value="#C13D3B65"/><Setter TargetName="Chrome" Property="Effect"><Setter.Value><DropShadowEffect Color="#A78BFA" BlurRadius="16" ShadowDepth="0" Opacity="0.22"/></Setter.Value></Setter></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.76"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#B35D4BC2"/><Setter Property="BorderBrush" Value="#D1BFFF"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Padding" Value="22,13"/>
    </Style>
    <Style x:Key="NavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Background" Value="#6F293653"/><Setter Property="BorderBrush" Value="#4B9A91C2"/><Setter Property="Padding" Value="17,14"/><Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#A51A2845"/><Setter Property="BorderBrush" Value="#8A8378B8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,12"/><Setter Property="CaretBrush" Value="#D1BFFF"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#B51B2947"/><Setter Property="BorderBrush" Value="#8A8378B8"/><Setter Property="Padding" Value="10"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/>
    </Style>
    <Style TargetType="{x:Type CheckBox}"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Margin" Value="0,8"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/></Style>
    <Style TargetType="{x:Type ListView}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  </Application.Resources>
</Application>