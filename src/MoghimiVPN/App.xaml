<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="MoghimiVPN.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
<Application.Resources>
<FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Estedad</FontFamily>
<SolidColorBrush x:Key="Bg" Color="#080914"/><SolidColorBrush x:Key="Panel" Color="#17162A"/><SolidColorBrush x:Key="Panel2" Color="#25203D"/><SolidColorBrush x:Key="Stroke" Color="#55466F"/><SolidColorBrush x:Key="Accent" Color="#A78BFA"/><SolidColorBrush x:Key="Accent2" Color="#E8C66A"/><SolidColorBrush x:Key="Muted" Color="#B8B0CF"/><SolidColorBrush x:Key="TextMain" Color="#F7F4FF"/>
<!-- Animation uses UIElement.Opacity only. No shared/frozen ScaleTransform is animated. -->
<Style TargetType="{x:Type TextBlock}">
  <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
  <Setter Property="FontSize" Value="15"/>
  <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
  <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
</Style>
<Style TargetType="{x:Type Button}">
<Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,11"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
<Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" Opacity="1">
<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#28365B"/><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#758CFF"/>
<Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="Opacity" To="0.94" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger>
<Trigger Property="IsMouseOver" Value="False"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger>
<Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#667CFF"/><Setter Property="BorderBrush" Value="#8E9EFF"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Padding" Value="22,13"/></Style>
<Style x:Key="NavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Background" Value="#10182A"/><Setter Property="BorderBrush" Value="#263450"/><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,4"/></Style>
<Style TargetType="{x:Type TextBox}"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#0D1423"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,11"/><Setter Property="CaretBrush" Value="#9AA9FF"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/></Style>
<Style TargetType="{x:Type ComboBox}"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#111A2C"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="Padding" Value="9"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/></Style>
<Style TargetType="{x:Type CheckBox}"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Margin" Value="0,7"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="15"/></Style>
<Style TargetType="{x:Type ListView}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
</Application.Resources></Application>